# GitNexus project environment. Keep secrets and machine-specific values in
# ignored local files, not in this tracked file.
dotenv_if_exists .env
dotenv_if_exists gitnexus/.env
source_env_if_exists .envrc.local

PATH_add node_modules/.bin
PATH_add gitnexus/node_modules/.bin
PATH_add gitnexus-web/node_modules/.bin
PATH_add gitnexus-shared/node_modules/.bin
